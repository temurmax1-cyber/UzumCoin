    <!-- Game Logic Script -->
    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyD3f-HZK1wclA2fzM1Sg8S1LRluap9qg7k",
            authDomain: "claude-coin.firebaseapp.com",
            projectId: "claude-coin",
            storageBucket: "claude-coin.firebasestorage.app",
            messagingSenderId: "478948716667",
            appId: "1:478948716667:web:d6ed5ddd8102e7bd0e72de",
            measurementId: "G-84V124881S"
        };
        if (!firebase.apps.length) {
            firebase.initializeApp(firebaseConfig);
        }
        const db = firebase.firestore();

        const ADMIN_ID = "6680296518";
        let tg = window.Telegram?.WebApp;
        if (tg) tg.expand();

        let user = tg?.initDataUnsafe?.user;
        let userId = user ? user.id.toString() : ADMIN_ID;
        let userName = user ? user.first_name : "Uzum Geymer";

        // UI Initialization & Tabs
        document.getElementById('username').innerText = userName;
        document.getElementById('profile-name').innerText = userName;
        document.getElementById('user-initial').innerText = userName.charAt(0).toUpperCase();

        if (userId === ADMIN_ID) {
            document.getElementById('nav-admin').classList.remove('hidden');
        }

        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-pane').forEach(el => el.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(el => {
                el.classList.remove('text-[#00FF3C]');
                el.classList.add('text-gray-400');
            });
            btn.classList.remove('text-gray-400');
            btn.classList.add('text-[#00FF3C]');
        }

        // Game State Variables
        let balance = 0;
        let energy = 500;
        let maxEnergy = 500;
        let tapPower = 1;
        let level = 1;
        let dailyEarned = 0;
        let referrals = [];

        const userRef = db.collection('uzum_users').doc(userId);

        // Load User Data from Firestore
        userRef.get().then(doc => {
            if (doc.exists) {
                const data = doc.data();
                balance = data.balance || 0;
                energy = data.energy !== undefined ? data.energy : 500;
                maxEnergy = data.maxEnergy || 500;
                tapPower = data.tapPower || 1;
                level = data.level || 1;
                dailyEarned = data.dailyEarned || 0;
                referrals = data.referrals || [];
                updateUI();
            } else {
                // Check if started with referral
                let startParam = tg?.initDataUnsafe?.start_param;
                if (startParam && startParam.startsWith('ref_')) {
                    let referrerId = startParam.replace('ref_', '');
                    if (referrerId !== userId) {
                        db.collection('uzum_users').doc(referrerId).get().then(refDoc => {
                            if (refDoc.exists) {
                                let refData = refDoc.data();
                                let refs = refData.referrals || [];
                                refs.push({ id: userId, name: userName });
                                db.collection('uzum_users').doc(referrerId).update({
                                    balance: (refData.balance || 0) + 500,
                                    referrals: refs
                                });
                            }
                        });
                    }
                }
                userRef.set({
                    name: userName,
                    balance: 0,
                    energy: 500,
                    maxEnergy: 500,
                    tapPower: 1,
                    level: 1,
                    dailyEarned: 0,
                    referrals: []
                });
            }
        });

        function updateUI() {
            document.getElementById('balance').innerText = balance.toLocaleString();
            document.getElementById('clicker-balance').innerText = balance.toLocaleString();
            document.getElementById('profile-balance').innerText = balance.toLocaleString();
            document.getElementById('energy').innerText = energy;
            document.getElementById('max-energy').innerText = maxEnergy;
            document.getElementById('user-level').innerText = level;
            document.getElementById('daily-earned').innerText = dailyEarned.toLocaleString() + " UZUM";
            document.getElementById('profile-ref-count').innerText = referrals.length;

            let percent = (energy / maxEnergy) * 100;
            document.getElementById('energy-bar').style.width = percent + '%';

