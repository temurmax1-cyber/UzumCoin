<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Uzum Coin WebApp</title>
    <!-- Telegram WebApp SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-firestore-compat.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap');
        
        body {
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(135deg, #0d0912 0%, #1a1226 50%, #4b0082 100%);
            color: #ffffff;
            overflow: hidden;
            user-select: none;
            -webkit-user-select: none;
        }

        .glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .glass-card {
            background: rgba(26, 18, 38, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(138, 43, 226, 0.2);
        }

        .coin-btn {
            transition: transform 0.05s ease;
        }
        .coin-btn:active {
            transform: scale(0.92);
        }

        @keyframes floatUp {
            0% { opacity: 1; transform: translateY(0) scale(1); }
            100% { opacity: 0; transform: translateY(-80px) scale(1.4); }
        }
        .floating-number {
            position: absolute;
            font-weight: 800;
            color: #00FF3C;
            font-size: 28px;
            pointer-events: none;
            animation: floatUp 0.8s ease-out forwards;
            text-shadow: 0 2px 10px rgba(0, 255, 60, 0.5);
        }

        ::-webkit-scrollbar {
            display: none;
        }
    </style>
</head>
<body class="h-screen flex flex-col justify-between select-none">

    <!-- Top Stats Header -->
    <header class="w-full px-5 pt-6 pb-2 z-10">
        <div class="glass rounded-2xl p-4 flex items-center justify-between shadow-lg border-purple-500/20">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-full bg-purple-500/20 border border-purple-500/40 flex items-center justify-center font-bold text-purple-300" id="user-initial">🍇</div>
                <div>
                    <h2 id="username" class="text-sm font-semibold text-gray-200">Geymer</h2>
                    <p class="text-xs text-[#00FF3C] font-medium">Daraja: <span id="user-level">1</span></p>
                </div>
            </div>
            <div class="text-right">
                <div class="text-xs text-gray-400 uppercase tracking-wider">BALANS</div>
                <div class="text-xl font-extrabold text-[#00FF3C] flex items-center justify-end gap-1">
                    <span id="balance">0</span> <span class="text-sm">UZUM</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area (Tabs) -->
    <main id="main-content" class="flex-1 overflow-y-auto px-5 pb-28 pt-2 relative flex flex-col items-center">
        
        <!-- CLICKER TAB -->
        <div id="tab-clicker" class="tab-pane flex flex-col items-center justify-center w-full h-full">
            <div class="glass-card px-4 py-2 rounded-xl mb-3 flex items-center gap-2 border border-purple-500/30">
                <span class="text-xs text-gray-400">24 soatda yig'ildi:</span>
                <span class="text-xs font-bold text-[#00FF3C]" id="daily-earned">0 UZUM</span>
            </div>

            <div class="text-center mb-4">
                <div class="text-xs text-gray-400 uppercase tracking-wider mb-1">JAMI UZUM TANGA</div>
                <div class="text-4xl font-extrabold tracking-tight text-white flex items-center justify-center gap-2">
                    <span class="text-3xl">🍇</span>
                    <span id="clicker-balance">0</span>
                </div>
            </div>

            <div class="relative flex items-center justify-center my-2" id="click-container" style="width: 240px; height: 240px;">
                <div class="absolute w-full h-full rounded-full bg-purple-600/20 blur-xl animate-pulse"></div>
                <button id="tap-btn" class="coin-btn relative w-56 h-56 rounded-full p-2 glass flex items-center justify-center shadow-2xl border-2 border-[#00FF3C]/40 focus:outline-none bg-gradient-to-br from-purple-900 to-indigo-950">
                    <div class="w-full h-full rounded-full overflow-hidden shadow-inner flex items-center justify-center bg-slate-950">
                        <span class="text-8xl select-none pointer-events-none">🍇</span>
                    </div>
                </button>
            </div>

            <div class="w-full max-w-xs mt-4">
                <div class="flex justify-between text-xs text-gray-300 mb-2 font-medium">
                    <span class="flex items-center gap-1">⚡ Energiya</span>
                    <span><span id="energy">500</span> / <span id="max-energy">500</span></span>
                </div>
                <div class="w-full bg-slate-900/80 rounded-full h-3 p-0.5 border border-purple-500/20">
                    <div id="energy-bar" class="bg-gradient-to-r from-purple-500 to-[#00FF3C] h-full rounded-full transition-all duration-200" style="width: 100%;"></div>
                </div>
            </div>
        </div>

        <!-- EARN / TASKS TAB -->
        <div id="tab-earn" class="tab-pane hidden w-full h-full flex flex-col">
            <h1 class="text-2xl font-bold mb-4 text-center">Vazifalar</h1>
            <div id="tasks-list" class="space-y-3 overflow-y-auto flex-1 pr-1">
                <p class="text-center text-gray-400 text-sm">Yuklanmoqda...</p>
            </div>
        </div>

        <!-- BOOST TAB -->
        <div id="tab-boost" class="tab-pane hidden w-full h-full flex flex-col">
            <h1 class="text-2xl font-bold mb-4 text-center">Bustlar va Kartalar</h1>
            <div class="space-y-3 overflow-y-auto flex-1 pr-1">
                <div class="glass-card p-4 rounded-2xl flex items-center justify-between">
                    <div>
                        <h3 class="font-semibold text-sm">Turbo Tap (+1 kuch)</h3>
                        <p class="text-xs text-gray-400">Narxi: 15,000 UZUM</p>
                    </div>
                    <button onclick="buyUpgrade('tap')" class="bg-purple-500/20 border border-purple-500/40 text-[#00FF3C] font-bold px-4 py-2 rounded-xl text-xs active:scale-95 transition">Sotib olish</button>
                </div>
                <div class="glass-card p-4 rounded-2xl flex items-center justify-between">
                    <div>
                        <h3 class="font-semibold text-sm">Energiya sig'imini oshirish</h3>
                        <p class="text-xs text-gray-400">Narxi: 20,000 UZUM</p>
                    </div>
                    <button onclick="buyUpgrade('energy')" class="bg-purple-500/20 border border-purple-500/40 text-[#00FF3C] font-bold px-4 py-2 rounded-xl text-xs active:scale-95 transition">Sotib olish</button>
                </div>
                <div class="glass-card p-4 rounded-2xl flex items-center justify-between">
                    <div>
                        <h3 class="font-semibold text-sm">Reklama ko'rish</h3>
                        <p class="text-xs text-gray-400">Reklama ko'rib +60 UZUM oling</p>
                    </div>
                    <button onclick="watchAd()" class="bg-[#00FF3C] text-slate-950 font-bold px-4 py-2 rounded-xl text-xs active:scale-95 transition">Ko'rish</button>
                </div>
            </div>
        </div>

        <!-- AUCTION TAB -->
        <div id="tab-auction" class="tab-pane hidden w-full h-full flex flex-col">
            <div class="flex justify-between items-center mb-4">
                <h1 class="text-2xl font-bold">Auksion</h1>
                <span class="text-xs text-gray-400">Sovg'ani tanlang</span>
            </div>
            <div id="auction-list" class="space-y-3 overflow-y-auto flex-1 pr-1">
                <p class="text-center text-gray-400 text-sm">Yuklanmoqda...</p>
            </div>
        </div>

        <!-- FRIENDS / PROFILE TAB -->
        <div id="tab-friends" class="tab-pane hidden w-full h-full flex flex-col">
            <h1 class="text-2xl font-bold mb-2 text-center">Do'stlar va Profil</h1>
            <p class="text-xs text-[#00FF3C] mb-4 text-center font-semibold">Har bir taklif qilingan do'st uchun +500 UZUM beriladi!</p>
            
            <div class="glass-card p-4 rounded-2xl space-y-3 mb-4">
                <p class="text-sm">👤 Foydalanuvchi: <span id="profile-name" class="text-[#00FF3C] font-bold">--</span></p>
                <p class="text-sm">💰 Jami aktiv: <span id="profile-balance" class="text-[#00FF3C] font-bold">0</span> UZUM</p>
                <p class="text-sm">👥 Chaqirgan do'stlar: <span id="profile-ref-count" class="font-bold">0</span> ta</p>
                <p class="text-sm">🔗 Taklif havolasi:</p>
                <input type="text" id="ref-link-input" readonly class="w-full p-2 rounded-xl bg-slate-900 border border-purple-500/20 text-xs text-gray-300">
                <button onclick="copyRefLink()" class="w-full py-2 bg-[#00FF3C] text-slate-950 font-bold rounded-xl text-xs active:scale-95 transition">Havolani nusxalash</button>
            </div>

            <!-- Promo Code Section in Profile -->
            <div class="glass-card p-4 rounded-2xl space-y-2 mb-4">
                <h3 class="font-semibold text-sm text-[#00FF3C]">🎁 Promo Kod</h3>
                <p class="text-xs text-gray-400">Promo kodni kiriting va 300 UZUM oling!</p>
                <input type="text" id="promo-input" placeholder="6 xonali kodni kiriting" class="w-full p-2 rounded-xl bg-slate-900 border border-purple-500/20 text-xs text-white">
                <button onclick="redeemPromoCode()" class="w-full py-2 bg-[#00FF3C] text-slate-950 font-bold rounded-xl text-xs active:scale-95 transition">Tasdiqlash (+300)</button>
            </div>

            <h3 class="text-sm font-semibold mb-2">Siz taklif qilgan do'stlar:</h3>
            <div id="referrals-list" class="glass-card p-3 rounded-2xl overflow-y-auto max-h-32 text-xs text-gray-300 space-y-1">
                Hozircha do'stlar yo'q.
            </div>
        </div>

        <!-- ADMIN TAB (Only for ADMIN_ID) -->
        <div id="tab-admin" class="tab-pane hidden w-full h-full flex flex-col">
            <h1 class="text-2xl font-bold mb-4 text-center text-[#00FF3C]">Admin Panel</h1>
            
            <div class="space-y-4 overflow-y-auto flex-1 pr-1">
                <!-- Promo Code Generator -->
                <div class="glass-card p-4 rounded-2xl space-y-2">
                    <h3 class="font-semibold text-sm text-[#00FF3C]">🎟️ Promo Kod Generator (6 xonali)</h3>
                    <button onclick="adminGeneratePromo()" class="w-full py-2 bg-[#00FF3C] text-slate-950 font-bold rounded-xl text-xs">Yangi 300 UZUM Promo Kod Yaratish</button>
                    <div id="admin-generated-promo-display" class="text-xs text-amber-400 font-bold text-center mt-1"></div>
                </div>

                <div class="glass-card p-4 rounded-2xl space-y-2">
                    <h3 class="font-semibold text-sm">Yangi Vazifa Qo'shish</h3>
                    <input type="text" id="admin-task-title" placeholder="Vazifa nomi (Masalan: Kanalga obuna)" class="w-full p-2 rounded-xl bg-slate-900 border border-purple-500/20 text-xs">
                    <input type="text" id="admin-task-link" placeholder="Kanal havolasi (https://t.me/...)" class="w-full p-2 rounded-xl bg-slate-900 border border-purple-500/20 text-xs">
                    <input type="number" id="admin-task-reward" placeholder="Mukofot miqdori (Masalan: 500)" class="w-full p-2 rounded-xl bg-slate-900 border border-purple-500/20 text-xs">
                    <button onclick="adminAddTask()" class="w-full py-2 bg-[#00FF3C] text-slate-950 font-bold rounded-xl text-xs">Vazifa qo'shish</button>
                </div>
                <div id="admin-tasks-manage" class="space-y-2"></div>

                <div class="glass-card p-4 rounded-2xl space-y-2 mt-4">
                    <h3 class="font-semibold text-sm">Auksionga Sovg'a Qo'shish</h3>
                    <input type="text" id="admin-auction-title" placeholder="Sovg'a nomi (Masalan: Telegram Premium)" class="w-full p-2 rounded-xl bg-slate-900 border border-purple-500/20 text-xs">
                    <input type="text" id="admin-auction-img-url" placeholder="Rasm URL havolasi" class="w-full p-2 rounded-xl bg-slate-900 border border-purple-500/20 text-xs">
                    <input type="number" id="admin-auction-hours" placeholder="Tugash vaqti (soatda)" class="w-full p-2 rounded-xl bg-slate-900 border border-purple-500/20 text-xs">
                    <button onclick="adminCreateAuction()" class="w-full py-2 bg-[#00FF3C] text-slate-950 font-bold rounded-xl text-xs">Auksionni boshlash</button>
                </div>
                <div id="admin-auctions-manage" class="space-y-2"></div>

                <!-- All Users List -->
                <div class="glass-card p-4 rounded-2xl space-y-2 mt-4">
                    <h3 class="font-semibold text-sm text-[#00FF3C]">👥 Barcha Foydalanuvchilar Ro'yxati</h3>
                    <div id="admin-users-list" class="space-y-2 max-h-48 overflow-y-auto text-xs text-gray-300">
                        Yuklanmoqda...
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- AUCTION DETAIL MODAL -->
    <div id="auction-detail-view" class="hidden fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-xl p-5 overflow-y-auto">
        <button onclick="closeAuctionDetail()" class="text-[#00FF3C] font-bold text-sm mb-4 flex items-center gap-1">← Orqaga</button>
        <div id="auction-detail-content"></div>
    </div>

    <!-- Bottom Navigation Bar -->
    <nav class="fixed bottom-0 left-0 right-0 p-3 z-20">
        <div class="glass rounded-2xl p-2 flex justify-around items-center shadow-2xl max-w-md mx-auto border-purple-500/20">
            <button onclick="switchTab('clicker', this)" class="nav-btn flex flex-col items-center text-[#00FF3C] transition" data-target="clicker">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
                <span class="text-[9px] mt-1 font-semibold">O'yin</span>
            </button>
            <button onclick="switchTab('earn', this)" class="nav-btn flex flex-col items-center text-gray-400 hover:text-[#00FF3C] transition" data-target="earn">
